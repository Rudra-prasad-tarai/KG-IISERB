{
  "schema": {
    "Student": {
      "id": "unique student identifier",
      "name": "full name",
      "type": "BS | MS | PhD | PostDoc",
      "roll_no": "official roll number",
      "email": "email ID",
      "department": "department ID",
      "linkedin": "LinkedIn profile URL",
      "github": "GitHub profile URL",
      "research_group": "research group ID (if any)",
      "guide": "faculty ID (if any)"
    },

    "Faculty": {
      "id": "unique faculty identifier",
      "name": "full name",
      "email": "email ID",
      "department": "department ID",
      "position": "Professor | Associate Professor | Assistant Professor | PostDoc Mentor | etc.",
      "joined_year": "year of joining"
    },

    "ResearchGroup": {
      "id": "unique group identifier",
      "name": "research group name",
      "department": "department ID",
      "head": "faculty ID",
      "website": "homepage URL"
    },

    "Department": {
      "id": "unique department identifier",
      "name": "department name",
      "institute": "institute ID",
      "hod": "faculty ID"
    },

    "Institute": {
      "id": "unique institute identifier",
      "name": "institute name",
      "director": "director name",
      "location": "city, state",
      "established": "year of establishment"
    }
  },

  "examples": [
